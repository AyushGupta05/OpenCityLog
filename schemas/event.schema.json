{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bims.local/schemas/event.schema.json",
  "title": "Bims Normalized City Change Event",
  "type": "object",
  "required": [
    "schema_version",
    "city_id",
    "event_id",
    "title",
    "short_description",
    "year",
    "effective_date",
    "date_precision",
    "source_date_field",
    "category",
    "lens",
    "affected_area",
    "source_ids",
    "evidence",
    "confidence",
    "affected_signals",
    "explanation",
    "caveats",
    "provenance"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string"},
    "city_id": {"type": "string"},
    "event_id": {"type": "string"},
    "title": {"type": "string"},
    "subtitle": {"type": "string", "minLength": 12, "maxLength": 180},
    "details": {"type": "string", "minLength": 12, "maxLength": 500},
    "short_description": {"type": "string", "minLength": 12, "maxLength": 220},
    "year": {"type": "integer", "minimum": 1700},
    "effective_date": {"type": ["string", "null"], "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$"},
    "effective_date_range": {
      "type": ["object", "null"],
      "properties": {
        "start": {"type": ["string", "null"], "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$"},
        "end": {"type": ["string", "null"], "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$"}
      }
    },
    "date_precision": {
      "type": "string",
      "enum": ["day", "month", "year", "range", "unknown"]
    },
    "source_date_field": {"type": "string", "minLength": 1},
    "category": {"type": "string"},
    "lens": {"type": "string"},
    "geometry": {
      "type": ["object", "null"],
      "description": "GeoJSON geometry in EPSG:4326 when map redistribution is allowed. Null means the event remains inspectable through list/evidence paths while map geometry is withheld or unavailable."
    },
    "affected_area": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
      }
    },
    "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}, "minItems": 1},
    "confidence": {
      "type": "string",
      "enum": ["documented", "corroborated", "inferred", "disputed"]
    },
    "affected_signals": {"type": "array", "items": {"type": "string"}},
    "explanation": {"type": "string"},
    "caveats": {"type": "array", "items": {"type": "string"}},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["source_id", "label", "kind"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["source_url", "local_file", "changeset", "source_record"]},
        "url": {"type": ["string", "null"]},
        "file_path": {"type": ["string", "null"]},
        "record_id": {"type": ["string", "null"]},
        "accessed_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[^ ]+)?$"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["transform", "source_date_field", "geometry_source", "geometry_precision"],
      "properties": {
        "transform": {"type": "string", "minLength": 1},
        "source_path": {"type": ["string", "null"]},
        "source_record_id": {"type": ["string", "number", "null"]},
        "source_url": {"type": ["string", "null"]},
        "source_retrieved_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[^ ]+)?$"},
        "source_dataset_id": {"type": ["string", "null"]},
        "source_basis": {"type": ["string", "null"]},
        "source_date_field": {"type": "string", "minLength": 1},
        "geometry_source": {"type": "string", "minLength": 1},
        "geometry_precision": {"type": "string", "minLength": 1}
      }
    }
  }
}
