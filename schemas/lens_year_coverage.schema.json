{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bims.local/schemas/lens_year_coverage.schema.json",
  "title": "Bims Lens-Year Coverage",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "generated_at",
    "city_id",
    "contract_source",
    "visual_reference_set",
    "required_years",
    "required_lens_count",
    "required_row_count",
    "row_count",
    "rows"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string"},
    "artifact_kind": {"type": "string", "enum": ["bims_lens_year_coverage"]},
    "generated_at": {"type": "string"},
    "city_id": {"type": "string"},
    "display_name": {"type": "string"},
    "contract_source": {"type": "string"},
    "visual_reference_set": {"type": "string"},
    "required_years": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 2007, "maximum": 2007},
        "end": {"type": "integer", "minimum": 2026, "maximum": 2026}
      }
    },
    "required_lens_count": {"type": "integer", "minimum": 15, "maximum": 15},
    "required_row_count": {"type": "integer", "minimum": 300, "maximum": 300},
    "row_count": {"type": "integer", "minimum": 300, "maximum": 300},
    "status_counts": {"type": "object"},
    "rows": {
      "type": "array",
      "minItems": 300,
      "maxItems": 300,
      "items": {"$ref": "#/$defs/coverage_row"}
    }
  },
  "$defs": {
    "coverage_row": {
      "type": "object",
      "required": [
        "city_id",
        "lens_slug",
        "public_label",
        "group",
        "category",
        "year",
        "required_year",
        "visible_map_contract",
        "status",
        "event_count",
        "compatible_event_count",
        "detail_feature_count",
        "coverage_context_feature_count",
        "headline_count_included",
        "headline_count_excluded_context_features",
        "source_count",
        "source_ids",
        "evidence_basis",
        "map_artifacts",
        "limitations",
        "exports"
      ],
      "additionalProperties": true,
      "properties": {
        "city_id": {"type": "string"},
        "lens_slug": {"type": "string"},
        "public_label": {"type": "string"},
        "group": {"type": "string", "enum": ["planning", "transport", "civic", "economy", "utilities"]},
        "category": {"type": "string"},
        "year": {"type": "integer", "minimum": 2007, "maximum": 2026},
        "required_year": {"type": "boolean"},
        "visible_map_contract": {"type": "boolean"},
        "status": {
          "type": "string",
          "enum": [
            "source_backed_records",
            "source_backed_context_no_year_records",
            "missing_source_backed_view"
          ]
        },
        "event_count": {"type": "integer", "minimum": 0},
        "compatible_event_count": {"type": "integer", "minimum": 0},
        "detail_feature_count": {"type": "integer", "minimum": 0},
        "coverage_context_feature_count": {"type": "integer", "minimum": 0},
        "headline_count_included": {"type": "integer", "minimum": 0},
        "headline_count_excluded_context_features": {"type": "integer", "minimum": 0},
        "confidence_counts": {"type": "object"},
        "source_count": {"type": "integer", "minimum": 0},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "compatible_source_ids": {"type": "array", "items": {"type": "string"}},
        "evidence_basis": {"type": "string", "minLength": 1},
        "map_artifacts": {
          "type": "object",
          "required": ["events_json", "events_geojson", "lens_detail_geojson"],
          "properties": {
            "events_json": {"type": "string", "minLength": 1},
            "events_geojson": {"type": "string", "minLength": 1},
            "lens_detail_geojson": {"type": "string", "minLength": 1}
          }
        },
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exports": {
          "type": "object",
          "required": [
            "markdown",
            "csv",
            "geojson",
            "includes_uncertainty_confidence_limitations_licenses_transform_notes"
          ],
          "properties": {
            "markdown": {"type": "boolean"},
            "csv": {"type": "boolean"},
            "geojson": {"type": "boolean"},
            "includes_uncertainty_confidence_limitations_licenses_transform_notes": {"type": "boolean"}
          }
        }
      }
    }
  }
}
