{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bims.local/schemas/availability.schema.json",
  "title": "Bims City Data Availability Matrix",
  "type": "object",
  "required": ["schema_version", "city_id", "generated_at", "matrix"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string"},
    "city_id": {"type": "string"},
    "generated_at": {"type": "string"},
    "matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family_id", "label", "availability", "years", "source_ids", "notes"],
        "properties": {
          "family_id": {"type": "string"},
          "label": {"type": "string"},
          "availability": {"type": "string"},
          "years": {"type": "array", "items": {"type": "integer", "minimum": 1700}},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "event_count": {"type": "integer", "minimum": 0},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
