{
  "name": "bims-city-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Static-first city atlas data foundation for source-backed urban changelog artifacts.",
  "scripts": {
    "build:data": "node scripts/build_city_atlas_all.js",
    "ingest:open-sources": "node scripts/run_python.js scripts/expand_london_nyc_events_from_open_sources.py && npm run build:data",
    "ingest:public-context": "node scripts/run_python.js scripts/build_london_nyc_public_context.py && npm run build:lens-overlays && npm run build:coverage",
    "build:coverage": "node scripts/build_city_coverage_report.js",
    "build:architecture-coverage": "node scripts/build_architecture_coverage_report.js",
    "sync:architecture-registry": "node scripts/sync_architecture_source_registry.js",
    "build:architecture-source-registry": "node scripts/build_architecture_source_registry.js",
    "spot-check:architecture-urls": "node scripts/spot_check_architecture_urls.js",
    "build:events": "node scripts/build_infrastructure_events.js",
    "build:transit": "node scripts/build_translink_transit_layers.js",
    "fetch:utilities-osm": "node scripts/fetch_belfast_utility_context_osm.js",
    "build:utilities": "node scripts/build_utility_network_context.js",
    "build:economy-anchors": "node scripts/build_economy_anchor_context.js",
    "build:civic-services": "node scripts/build_civic_service_context.js",
    "build:detail-layers": "node scripts/build_osm_detail_layers.js",
    "build:lens-overlays": "node scripts/build_lens_overlays_by_city.js",
    "fetch:city-roads": "node scripts/fetch_city_osm_roads.js",
    "build": "npm run build:events && npm run build:transit && npm run build:data && npm run verify",
    "start": "node server.js",
    "verify:data": "node scripts/verify_data.js",
    "verify:architecture": "node scripts/verify_architecture_scope.js",
    "verify:schema": "node scripts/validate_city_atlas_schema.js",
    "verify:proposal": "node scripts/verify_proposal_impact.js",
    "verify": "npm run verify:schema && npm run verify:data && npm run verify:architecture && node scripts/verify_no_legacy_paths.js && node scripts/verify-manifest.js && npm run verify:proposal",
    "verify:timeline-basemap": "node scripts/timeline_imagery_smoke.js",
    "verify:timeline-state": "node scripts/timeline_state_smoke.js",
    "verify:timeline-imagery": "npm run verify:timeline-basemap",
    "verify:browser": "node scripts/browser_smoke.js && node scripts/dashboard_smoke.js && npm run verify:timeline-basemap && npm run verify:timeline-state",
    "coverage:python": "node scripts/run_python_coverage.js",
    "test": "npm run build && npm run coverage:python"
  },
  "devDependencies": {
    "playwright": "^1.51.1"
  }
}
